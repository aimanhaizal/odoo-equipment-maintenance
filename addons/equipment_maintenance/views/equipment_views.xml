<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_portfolio_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.portfolio.list</field>
        <field name="model">maintenance.equipment.portfolio</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="location"/>
                <field name="purchase_date"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_equipment_portfolio_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.portfolio.form</field>
        <field name="model">maintenance.equipment.portfolio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="serial_number"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_equipment_portfolio" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">maintenance.equipment.portfolio</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_equipment_maintenance_root"
        name="Equipment Hub"
        sequence="15"
    />

    <menuitem
        id="menu_equipment_portfolio"
        name="Equipment"
        parent="menu_equipment_maintenance_root"
        action="action_equipment_portfolio"
        sequence="10"
    />
</odoo>
